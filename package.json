{
  "name": "hexstacker-party",
  "version": "4.6.1",
  "description": "Browser-based multiplayer hex stacker with phone controllers",
  "main": "server/index.js",
  "scripts": {
    "build": "node scripts/build.js && node scripts/generate-airconsole-html.js",
    "build:core": "node scripts/build.js --core",
    "build:conformance": "node scripts/build-conformance-bundle.js",
    "build:golden": "node scripts/gen-room-core-golden.js",
    "build:native": "npm run build:core && npm run build:conformance",
    "start": "npm run build && node server/index.js",
    "dev": "node scripts/generate-airconsole-html.js && node --watch server/index.js",
    "test": "node --test \"tests/**/*.test.js\" \"partyplug/tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\" \"partyplug/tests/**/*.test.js\"",
    "test:e2e": "npx playwright test --project=e2e",
    "test:e2e:airconsole": "AC_MOCK=1 npx playwright test --project=e2e-airconsole",
    "test:e2e:all": "AC_MOCK=1 npx playwright test --project=e2e --project=e2e-airconsole",
    "record:transitions": "npm run build && node scripts/record-transitions.js",
    "record:transitions:tvos": "scripts/record-transitions-tvos.sh",
    "ad:capture": "node artwork/ad-clip/capture.js",
    "ad:stitch": "node artwork/ad-clip/stitch.js",
    "ad": "npm run ad:capture && npm run ad:stitch",
    "ad:prod": "AD_PROD=1 npm run ad",
    "ad:max": "AD_MAX=1 npm run ad"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1"
  }
}
